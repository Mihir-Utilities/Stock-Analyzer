# ---- Copy to .env (local) and to the host/GitHub secret stores. NEVER commit real values. ----

# Shared
DATABASE_URL=                      # Neon connection string (sslmode=require)
BROKER_TOKEN_KEY=                  # 32 random bytes, base64 (AES-256-GCM key for broker tokens). API and worker only.
WORKER_HMAC_KEY=                   # long random string shared by API and worker-http
LOG_LEVEL=info

# API (Go)
PORT=8080
CONFIG_DIR=config                  # directory holding research_links.json (read at API start)
APP_BASE_URL=                      # public URL of the web app (https://...)
API_PUBLIC_URL=                    # public URL of this API (used for OAuth redirect + Telegram webhook)
INITIAL_PASSWORD_HASH=             # argon2id hash produced by the seed helper (never a plaintext password)
WORKER_BASE_URL=                   # worker-http base URL
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=           # random string, sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_BOT_USERNAME=
BROKER_ENABLED=false               # MANUAL PRICE MODE (owner decision D-1): prices via prices.csv uploads. All BROKER_* variables below are dormant; leave empty
BROKER_NAME=                       # decided in spike S1 (angelone|fyers|upstox|dhan)
BROKER_CLIENT_ID=                  # from the broker developer console (read-only/data scope)
BROKER_CLIENT_SECRET=
BROKER_REDIRECT_URI=               # API_PUBLIC_URL/api/v1/broker/callback
# PRICES_ALREADY_ADJUSTED is NOT an env var: it is an app_setting the owner chooses in the prices import wizard (manual S4)
SCREENER_IMPORT_ENABLED=false      # keep false unless the owner has read Screener's terms and accepts the risk
IMPORT_PRICES_LARGE_ENABLED=false  # true = prices uploads up to 25 MB / 300,000 rows; set only after spike S9 passed the large upload (default 5 MB / 50,000 rows)

# Worker (Python)
AGE_PUBLIC_KEY=                    # for encrypted backups (public key only)

# Web (Next.js)
API_BASE_URL=                      # Go API base URL used by the /api rewrite

# Tunables (MASTER_PLAN section 5). Rows in app_setting; an env var overrides the stored default. Empty = use the default shown.
PRICE_HISTORY_YEARS_TRACKED=       # default 5
LAZY_BACKFILL_MAX_YEARS=           # default 20 (broker mode only; inactive in manual price mode)
OPENED_STOCKS_LRU_CAP=             # default 150
MFAPI_MIN_INTERVAL_SEC=            # default 0.5
REFRESH_COOLDOWN_MIN=              # default 15
REFRESH_GLOBAL_PER_HOUR=           # default 30
RISK_FREE_RATE=                    # default 0.065 (owner-editable in the app)
SESSION_DAYS=                      # default 30
LOGIN_MAX_FAILS=                   # default 5
TRUSTED_PROXY_HOPS=                # default 0 = ignore X-Forwarded-For; Render alone = 1 (see docs/RUNBOOK.md)
DB_SOFT_LIMIT_MB=                  # default 380

