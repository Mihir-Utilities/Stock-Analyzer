# ---- Copy to .env (local) and to the host/GitHub secret stores. NEVER commit real values. ----

# Shared
DATABASE_URL=                      # Neon connection string (sslmode=require)
BROKER_TOKEN_KEY=                  # 32 random bytes, base64 (AES-256-GCM key for broker tokens). API and worker only.
WORKER_HMAC_KEY=                   # long random string shared by API and worker-http
LOG_LEVEL=info

# API (Go)
PORT=8080
APP_BASE_URL=                      # public URL of the web app (https://...)
API_PUBLIC_URL=                    # public URL of this API (used for OAuth redirect + Telegram webhook)
INITIAL_PASSWORD_HASH=             # argon2id hash produced by the seed helper (never a plaintext password)
WORKER_BASE_URL=                   # worker-http base URL
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=           # random string, sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_BOT_USERNAME=
BROKER_ENABLED=true                # false = manual price mode (prices.csv uploads only)
BROKER_NAME=                       # decided in spike S1 (angelone|fyers|upstox|dhan)
BROKER_CLIENT_ID=                  # from the broker developer console (read-only/data scope)
BROKER_CLIENT_SECRET=
BROKER_REDIRECT_URI=               # API_PUBLIC_URL/api/v1/broker/callback
BROKER_PRICES_ADJUSTED=false       # set after spike S4
SCREENER_IMPORT_ENABLED=false      # keep false unless the owner has read Screener's terms and accepts the risk

# Worker (Python)
AGE_PUBLIC_KEY=                    # for encrypted backups (public key only)

# Web (Next.js)
API_BASE_URL=                      # Go API base URL used by the /api rewrite
